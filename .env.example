# Where waitlist/volunteer submissions are POSTed. Leave unset to run in stub
# mode (the form validates and shows success without sending anywhere).
# Must be VITE_-prefixed so Vite inlines it into the static build.
#
# This project targets SheetDB (https://sheetdb.io): submissions become rows in
# a Google Sheet. The sheet's FIRST ROW must contain these column headers:
#   date    kind    contact    source    city    region    country    ip    useragent
VITE_WAITLIST_ENDPOINT=https://sheetdb.io/api/v1/694e8ndlou2da
